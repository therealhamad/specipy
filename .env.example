# Copy to .env and fill in. The orchestrator reads this at import time.

# --- Claude Managed Agents -------------------------------------------------
# Either an API key, or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Printed by: python -m orchestrator.agent_setup create
AGENT_ID=
ENVIRONMENT_ID=

AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=xhigh
AGENT_NAME=api-drift-fixer
ENVIRONMENT_NAME=api-drift-sandbox

# Only needed for correct Console trace links if your key is not in the
# Default workspace.
ANTHROPIC_WORKSPACE_ID=default

# --- Repository the agent edits -------------------------------------------
GITHUB_REPO_URL=https://github.com/<owner>/<repo>
# Fine-grained PAT. Contents: Read and write — confirm this BEFORE the first
# run, or the agent's push fails at the very end of an otherwise good session.
GITHUB_TOKEN=
GITHUB_MOUNT_PATH=/workspace/repo
GITHUB_BASE_BRANCH=main

# --- Voice (Maya Research / Veena) ----------------------------------------
# Base URL; the synthesis path (/tts) is appended automatically.
# Model must be one the endpoint accepts: Maya 2 Native, Maya 2 Native Emotional,
# Maya 2 Global. Verify with: make voice-check
MAYA_API_URL=https://tts.mayaresearch.ai
MAYA_API_KEY=
MAYA_MODEL=Maya 2 Native
MAYA_LANGUAGE=en
MAYA_VOICE=

# --- Behaviour ------------------------------------------------------------
# 1 replays a scripted run instead of calling the API. Labelled as simulated
# everywhere it surfaces, so it can't be mistaken for a real run.
DEMO_MODE=0
SESSION_TIMEOUT_SECONDS=1800

# --- Consumer app --------------------------------------------------------
PROVIDER_URL=http://127.0.0.1:8001
